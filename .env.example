# 复制为 .env 后填写。.env 不进仓库，密钥只在服务端读取。

# 智谱 GLM（OpenAI 兼容接口），plostain.config.ts 里的 "glm" provider 使用
LLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
LLM_API_KEY=

# Anthropic API：两套配置（plostain.config.ts 里的 "fable" 和 "opus"）。ENDPOINT 留空 = 官方地址
FABLE_ENDPOINT=
FABLE_API_KEY=
FABLE_MODEL=claude-fable-5-1
OPUS_ENDPOINT=
OPUS_API_KEY=
OPUS_MODEL=claude-opus-5-5
